# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Configuration
GOOGLE_API_KEY=your_google_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Choose AI provider: 'openai' or 'gemini'
AI_PROVIDER=gemini

# Google Forms Health Questionnaire URL
GOOGLE_FORM_URL=https://forms.gle/your_form_id

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/patient_discharge_db

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# OpenRouter API Configuration (for AI summaries)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Email Configuration (for care team notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=noreply@hospital.com
